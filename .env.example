# Cloud backend: "lumos" (self-hosted REST server in /cloud-server) or "supabase"
VITE_CLOUD_PROVIDER=lumos
VITE_LUMOS_CLOUD_URL=http://127.0.0.1:8787
# Only for provider=supabase (anon key is public by design; RLS protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Daemon WebSocket (used when the UI runs outside Electron, e.g. `npm run dev` in a browser)
VITE_DAEMON_URL=ws://127.0.0.1:7420
