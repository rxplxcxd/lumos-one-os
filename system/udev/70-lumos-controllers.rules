# Third-party controllers: event nodes writable for rumble (force feedback) and hidraw access for
# Steam Input / SDL (gyro, LEDs, battery) — scoped to the logged-in seat (uaccess).
# Install to /etc/udev/rules.d/70-lumos-controllers.rules

# Sony DualShock 4 / DualSense / DualSense Edge
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4|09cc|0ba0|0ce6|0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:05C4*|*054C:09CC*|*054C:0CE6*|*054C:0DF2*", MODE="0660", TAG+="uaccess"
# Nintendo Switch Pro Controller / Joy-Con (USB + Bluetooth)
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="2006|2007|2009|200e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2006*|*057E:2007*|*057E:2009*", MODE="0660", TAG+="uaccess"
# Microsoft Xbox, 8BitDo, HORI, PDP, PowerA, Logitech, Razer, Mad Catz, GameSir, Valve
SUBSYSTEMS=="usb", ATTRS{idVendor}=="045e|2dc8|0f0d|0e6f|24c6|20d6|046d|1532|0738|3537|28de", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="2dc8|0f0d|28de|3537", MODE="0660", TAG+="uaccess"

# every joystick event node: rumble needs write access
SUBSYSTEM=="input", ENV{ID_INPUT_JOYSTICK}=="1", KERNEL=="event*", MODE="0660", GROUP="input", TAG+="uaccess"
